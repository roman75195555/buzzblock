{
  "name": "SeedRush",
  "globIgnorePaths": ["**/.DS_Store", "**/*.md"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 150,
        "CameraMinZoomDistance": 8,
        "CharacterUseJumpPower": true,
        "CharacterJumpPower": 55,
        "CharacterWalkSpeed": 16
      }
    },

    "StarterPack": {
      "$className": "StarterPack",
      "Dumbbell": {
        "$path": "assets/DumbbellTool.rbxm"
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 196.2,
        "StreamingEnabled": false
      },
      "Map": {
        "$path": "assets/Map.rbxm"
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.35, 0.35, 0.38],
        "OutdoorAmbient": [0.45, 0.47, 0.5],
        "Brightness": 2,
        "ClockTime": 14,
        "GeographicLatitude": 35,
        "GlobalShadows": true,
        "Technology": "Future"
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "CelestialBodiesShown": true,
          "SunAngularSize": 11
        }
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.25,
          "Color": [0.75, 0.82, 0.9],
          "Decay": [0.9, 0.9, 0.95],
          "Glare": 0.2,
          "Haze": 1.5
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 24,
          "Threshold": 1.4
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.08,
          "Spread": 0.8
        }
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
