{
  "name": "LunarBase",
  "globIgnorePaths": ["**/.DS_Store", "**/*.md"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 200,
        "CameraMinZoomDistance": 8,
        "CharacterUseJumpPower": true,
        "CharacterJumpPower": 50,
        "CharacterWalkSpeed": 16
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 32,
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.32, 0.33, 0.38],
        "OutdoorAmbient": [0.38, 0.4, 0.45],
        "Brightness": 2,
        "ClockTime": 0,
        "GlobalShadows": true,
        "Technology": "Future",
        "FogColor": [0.02, 0.02, 0.04],
        "FogStart": 600,
        "FogEnd": 2500
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "CelestialBodiesShown": true,
          "StarCount": 5000,
          "MoonAngularSize": 0,
          "SunAngularSize": 0
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.7,
          "Size": 24,
          "Threshold": 1.3
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.08,
          "Saturation": -0.15
        }
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
